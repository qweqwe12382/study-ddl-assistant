# Public address. Use a domain name for automatic HTTPS, for example:
# SITE_ADDRESS=study.example.com
# For temporary IP-only testing, use: SITE_ADDRESS=:80
SITE_ADDRESS=study.example.com
# Optional operator address displayed on the public privacy page.
VITE_PUBLIC_CONTACT_EMAIL=
TLS_EMAIL=admin@example.com

APP_ENV=production
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=true

# Enable after configuring a Turnstile widget for this hostname.
AUTH_TURNSTILE_ENABLED=false
AUTH_TURNSTILE_SITE_KEY=
AUTH_TURNSTILE_SECRET_KEY=
AUTH_TURNSTILE_HOSTNAME=study.example.com

# Enable after configuring a TLS SMTP sender and a random secret of at least 32 characters.
AUTH_EMAIL_VERIFICATION_ENABLED=false
AUTH_EMAIL_CODE_SECRET=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_STARTTLS=false
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=

LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=20
MAX_UPLOAD_FILES=10
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
OCR_MODE=local
DEMO_MODE=false
CORS_ORIGINS=https://study.example.com
