# Public address. Use a domain name for automatic HTTPS, for example:
# SITE_ADDRESS=study.example.com
# For temporary IP-only testing, use: SITE_ADDRESS=:80
SITE_ADDRESS=study.example.com
TLS_EMAIL=admin@example.com

APP_ENV=production
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=true
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=20
MAX_UPLOAD_FILES=10
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
OCR_MODE=local
DEMO_MODE=false
CORS_ORIGINS=https://study.example.com
